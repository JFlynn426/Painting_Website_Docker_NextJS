{
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "GoogleAuth": {
        "ClientId": "${GOOGLE_AUTH_CLIENT_ID}",
        "ClientSecret": "${GOOGLE_AUTH_CLIENT_SECRET}",
        "RedirectUri": "${GOOGLE_AUTH_REDIRECT_URI}"
    },
    "Admin": {
        "JwtSecretKey": "${ADMIN_JWT_SECRET_KEY}",
        "JwtExpiryMinutes": "${ADMIN_JWT_EXPIRY_MINUTES}",
        "AuthorizedEmails": "${ADMIN_AUTHORIZED_EMAILS}"
    }
}