# ============================================================================
# Environment Configuration for Art Gallery Application
# ============================================================================
# Copy this file to .env and update the values for your environment
# ============================================================================

# PostgreSQL Configuration
# IMPORTANT: For production, use Docker secrets (see instructions below)
# For development, you can use this environment variable
# POSTGRES_PASSWORD=ChangeMeToASecurePassword123!
#
# PRODUCTION: Create secrets file at docker-compose/secrets/postgres_password
# with your password (no quotes, no trailing newline)
# Then the password will be automatically loaded by Docker secrets

# CORS Configuration
# Add additional origins separated by commas
# Development: http://localhost:3000
# Production: https://ggpaintings.com
CORS_ALLOWED_ORIGINS=https://ggpaintings.com,https://www.ggpaintings.com

# API Configuration
# The API container runs on port 8080 internally
# In development, this port is exposed to localhost:8080
API_PORT=8080

# Frontend Configuration
# The frontend container runs on port 3000 internally
# In development, this port is exposed to localhost:3000
FRONTEND_PORT=3000

# ============================================================================
# API URL Configuration
# ============================================================================
# IMPORTANT: Understanding the two API URLs
#
# NEXT_PUBLIC_API_URL: Used by the BROWSER to access the API
#   - Development: Browser accesses API directly at http://localhost:8080/api
#   - Production: Browser accesses API via NGINX at /api (same domain, no CORS)
#
# SERVER_API_URL: Used by Next.js SERVER COMPONENTS inside Docker container
#   - Always uses internal Docker network URL: http://api:8080/api
#   - This is NOT exposed to the browser (no NEXT_PUBLIC_ prefix)
# ============================================================================

# Development mode (default) - Docker without NGINX
# NEXT_PUBLIC_API_URL=http://localhost:8080/api
# SERVER_API_URL=http://api:8080/api

# Production mode with NGINX (Cloudflare Full mode)
NEXT_PUBLIC_API_URL=https://ggpaintings.com/api
SERVER_API_URL=http://api:8080/api

# ============================================================================
# Google OAuth Configuration for Admin Login
# ============================================================================
# Get these values from https://console.cloud.google.com/apis/credentials
# Redirect URI should be: https://ggpaintings.com/admin/login (or your domain)
# GOOGLE_AUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_AUTH_CLIENT_SECRET=your-client-secret
# GOOGLE_AUTH_REDIRECT_URI=https://ggpaintings.com/admin/login

# ============================================================================
# Admin Authentication Configuration
# ============================================================================
# JWT Secret Key - generate a random 64+ character string
# Example: openssl rand -base64 64
# ADMIN_JWT_SECRET_KEY=your-secret-key-here
# ADMIN_JWT_EXPIRY_MINUTES=60
# ADMIN_AUTHORIZED_EMAILS=email1@example.com,email2@example.com

# ============================================================================
# NGINX Configuration (Production Only)
# ============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_HEALTH_PORT=8080