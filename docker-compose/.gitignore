# Environment files with actual secrets
.env
.env.local
.env.*.local
.env.multi
.env.multi.arm64

# Secrets directory (except .gitkeep)
secrets/*
!secrets/.gitkeep

# Logs
*.log

# Local + server backup dumps.
# All four backup generators emit .dump archives (backup.sh, backup-multi.sh,
# create-local-backup.ps1, create-local-backup-multi.ps1). A `pg_dump -Fc` archive
# of artgallery_gg / artgallery_flynn contains every AdminUser row (emails, Google
# `sub`, Yahoo `guid`), so the whole directory is ignored rather than individual
# extensions -- the old `*.bak`/`*.sha256`/`*.log` list did not match `.dump`.
backups/

# Shell redirection accidents (e.g. `2> $null` run under cmd.exe creates a real
# file named "$null"). The committed instance has been removed with git rm.
$null

# image-data/ is INTENTIONALLY TRACKED - do not add an ignore rule for it.
# It holds the per-site seed fixtures (image-data/gg, image-data/flynn) that the
# seed data references by path, mounted at /app/images. An ignore rule would also
# be inert here because the paths are already tracked.

# OS files
.DS_Store
Thumbs.db