# ============================================================================
# ARM64 Multi-Site Environment Configuration
# ============================================================================
# Copy this file to .env.multi.arm64 and fill in actual values.
#
# Usage:
#   docker compose -f docker-compose.multi.arm64.yml up -d --build
#
# Access sites at:
#   - Site gg:     http://localhost:8181
#   - Site flynn:  http://localhost:8182
#   - Health:      http://localhost:9090/health
#   - Frontend gg (direct):  http://localhost:3001
#   - Frontend flynn (direct): http://localhost:3002
#
# IMPORTANT:
# - Each site needs its own Google OAuth client ID configured in Google Cloud Console
# - JWT secrets should be long, random strings (use: openssl rand -base64 32)
# - This file uses environment variables (not Docker secrets) for PostgreSQL
# ============================================================================

# ============================================
# PostgreSQL
# ============================================
# ARM64 uses environment variable instead of Docker secrets
POSTGRES_PASSWORD=ChangeMeToASecurePassword123!

# ============================================
# NGINX Ports (Local Development)
# ============================================
# Port 80 maps to Site gg, Port 443 maps to Site flynn (via nginx.multi.local.conf)
NGINX_HTTP_PORT=8181
NGINX_HTTPS_PORT=8182
NGINX_HEALTH_PORT=9090

# ============================================
# Direct API Ports (for debugging)
# ============================================
API_PORT_GG=8081
API_PORT_FLYNN=8082

# ============================================
# Site: gg (ggpaintings.com)
# ============================================

# --- Frontend Site Configuration ---
GG_NAVBAR_ARTWORK_LABEL="Painting"
GG_NAVBAR_ARTWORK_LABEL_PLURAL="Paintings"
GG_SITE_NAME="Gloria Gronowicz Fine Art"
GG_SITE_DESCRIPTION="Gloria Gronowicz is an oil painter who combines fine art with conservation. As a former Ph.D. scientist she seeks to tell the story of different species and their varied habitats, particularly in South Florida. Through color and light she creates a vignette of life in nature."
GG_CONTACT_EMAIL="gloriagronowicz@gmail.com"
GG_CONTACT_PHONE="860.670.0799"

# --- CSS Theme Variables ---
GG_CSS_BACKGROUND="#3d3d3d"
GG_CSS_FOREGROUND="#ffffff"
GG_CSS_NAVBAR_FOOTER_BG="#2d2d2d"
GG_CSS_TITLE_COLOR="#66b3ff"
GG_CSS_BUTTON_COLOR="#1e3a8a"
GG_CSS_FONT="Manjari-Thin.ttf"
GG_CSS_LINK_HOVER="#60a5fa"
GG_CSS_MENU_HOVER="#1e3a8a"
GG_CSS_ADMIN_HOVER="#374151"

# --- Favicon ---
GG_FAVICON="/favicon-gg.ico"

# --- API URLs ---
GG_NEXT_PUBLIC_API_URL=/api
GG_SERVER_API_URL=http://api-gg:8080/api

# --- CORS ---
GG_CORS_ALLOWED_ORIGINS=https://localhost:8181

# --- Google OAuth ---
GG_GOOGLE_AUTH_CLIENT_ID=YOUR_GG_CLIENT_ID.apps.googleusercontent.com
GG_GOOGLE_AUTH_CLIENT_SECRET=YOUR_GG_CLIENT_SECRET
GG_GOOGLE_AUTH_REDIRECT_URI=https://localhost:8181/admin/login

# --- Yahoo OAuth ---
GG_YAHOO_AUTH_CLIENT_ID=YOUR_GG_YAHOO_CLIENT_ID
GG_YAHOO_AUTH_CLIENT_SECRET=YOUR_GG_YAHOO_CLIENT_SECRET
GG_YAHOO_AUTH_REDIRECT_URI=https://localhost:8181/admin/login

# --- Admin JWT ---
GG_ADMIN_JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_GG
GG_ADMIN_JWT_EXPIRY_MINUTES=60
GG_ADMIN_AUTHORIZED_EMAILS=gloriagronowicz@gmail.com

# --- Database ---
GG_DATABASE_READ_ONLY_MODE=false

# ============================================
# Site: flynn (flynnart.com)
# ============================================

# --- Frontend Site Configuration ---
FLYNN_NAVBAR_ARTWORK_LABEL="Artwork"
FLYNN_NAVBAR_ARTWORK_LABEL_PLURAL="Artwork"
FLYNN_SITE_NAME="Terri Gray Fine Art"
FLYNN_SITE_DESCRIPTION="Fine art paintings by Flynn"
FLYNN_CONTACT_EMAIL="texasterrigray@yahoo.com"
FLYNN_CONTACT_PHONE="512-461-8075"

# --- CSS Theme Variables ---
FLYNN_CSS_BACKGROUND="#d0d0d0"
FLYNN_CSS_FOREGROUND="#000000"
FLYNN_CSS_NAVBAR_FOOTER_BG="#adaa8d"
FLYNN_CSS_TITLE_COLOR="#2d5a4a"
FLYNN_CSS_BUTTON_COLOR="#2d5a4a"
FLYNN_CSS_FONT="NationalPark-Regular.ttf"
FLYNN_CSS_LINK_HOVER="#4a8e75"
FLYNN_CSS_MENU_HOVER="#4a8e75"
FLYNN_CSS_ADMIN_HOVER="#6ab89a"

# --- Favicon ---
FLYNN_FAVICON="/favicon-flynn.ico"

# --- API URLs ---
FLYNN_NEXT_PUBLIC_API_URL=/api
FLYNN_SERVER_API_URL=http://api-flynn:8080/api

# --- CORS ---
FLYNN_CORS_ALLOWED_ORIGINS=https://localhost:8182

# --- Google OAuth ---
FLYNN_GOOGLE_AUTH_CLIENT_ID=YOUR_FLYNN_CLIENT_ID.apps.googleusercontent.com
FLYNN_GOOGLE_AUTH_CLIENT_SECRET=YOUR_FLYNN_CLIENT_SECRET
FLYNN_GOOGLE_AUTH_REDIRECT_URI=https://localhost:8182/admin/login

# --- Yahoo OAuth ---
FLYNN_YAHOO_AUTH_CLIENT_ID=YOUR_FLYNN_YAHOO_CLIENT_ID
FLYNN_YAHOO_AUTH_CLIENT_SECRET=YOUR_FLYNN_YAHOO_CLIENT_SECRET
FLYNN_YAHOO_AUTH_REDIRECT_URI=https://localhost:8182/admin/login

# --- Admin JWT ---
FLYNN_ADMIN_JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_FLYNN
FLYNN_ADMIN_JWT_EXPIRY_MINUTES=60
FLYNN_ADMIN_AUTHORIZED_EMAILS=flynn@example.com

# --- Database ---
FLYNN_DATABASE_READ_ONLY_MODE=false
